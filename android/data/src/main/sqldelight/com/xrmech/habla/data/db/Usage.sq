CREATE TABLE usage_log (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id          INTEGER REFERENCES sessions(id) ON DELETE SET NULL,
    at                  TEXT NOT NULL,
    model               TEXT NOT NULL,
    kind                TEXT NOT NULL,
    input_tokens        INTEGER NOT NULL,
    cached_input_tokens INTEGER NOT NULL DEFAULT 0,
    output_tokens       INTEGER NOT NULL,
    cost_usd            REAL NOT NULL
);
CREATE INDEX usage_log_session_idx ON usage_log(session_id);

insertUsage:
INSERT INTO usage_log (session_id, at, model, kind, input_tokens, cached_input_tokens, output_tokens, cost_usd)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectTotalCost:
SELECT TOTAL(cost_usd) FROM usage_log;
