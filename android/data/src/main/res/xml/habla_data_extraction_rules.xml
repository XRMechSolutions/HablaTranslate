<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore/secrets.preferences_pb"/>
        <exclude domain="file" path="datastore/secrets.preferences_pb.tmp"/>
        <exclude domain="file" path="sessions/"/>
        <exclude domain="database" path="habla.db-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb"/>
        <exclude domain="file" path="datastore/secrets.preferences_pb.tmp"/>
        <exclude domain="database" path="habla.db-journal"/>
    </device-transfer>
</data-extraction-rules>
