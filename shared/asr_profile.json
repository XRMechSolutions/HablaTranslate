{
  "version": 1,
  "audio": {
    "sample_rate": 16000,
    "channels": 1
  },
  "vad": {
    "model": "silero_vad",
    "frame_samples": 512,
    "frame_ms": 32,
    "speech_threshold": 0.35,
    "energy_fallback_prob_scale": 2.0
  },
  "calibration": {
    "duration_ms": 2000,
    "min_energy_threshold": 300.0,
    "noise_floor_multiplier": 3.0,
    "uncalibrated_threshold": 500.0
  },
  "segmenter": {
    "silence_duration_ms": 600,
    "min_speech_ms": 200,
    "max_segment_seconds": 30.0,
    "pre_speech_padding_ms": 300,
    "partial_interval_ms": 1000
  },
  "merge": {
    "gap_seconds": 1.2,
    "max_pending_seconds": 60.0
  },
  "partial_prep": {
    "bandpass_hz": [
      80,
      7500
    ],
    "butterworth_order": 4,
    "target_rms": 3000.0,
    "max_gain": 10.0,
    "min_rms_for_gain": 10.0
  },
  "final_prep": {
    "highpass_hz": 80,
    "lowpass_hz": 7500,
    "dynaudnorm": {
      "frame_ms": 150,
      "gauss_size": 15,
      "peak": 0.95,
      "max_gain": 10.0
    }
  },
  "whisper": {
    "model": "small",
    "beam_size": 5,
    "final_batch_size": 8,
    "partial_batch_size": 4,
    "auto_language": true,
    "default_language": "es"
  },
  "language_vote": {
    "window": 5,
    "switch_ratio": 0.7
  },
  "filters": {
    "min_letters": 3,
    "min_letter_ratio": 0.5,
    "clipped_onset_pairs": [
      [
        "ola",
        "hola"
      ],
      [
        "ueno",
        "bueno"
      ],
      [
        "racias",
        "gracias"
      ],
      [
        "omo",
        "como"
      ],
      [
        "uiero",
        "quiero"
      ],
      [
        "engo",
        "tengo"
      ],
      [
        "stoy",
        "estoy"
      ],
      [
        "oy",
        "voy"
      ],
      [
        "ué",
        "qué"
      ],
      [
        "ónde",
        "dónde"
      ],
      [
        "uándo",
        "cuándo"
      ],
      [
        "orque",
        "porque"
      ]
    ]
  },
  "context": {
    "recent_exchanges": 10,
    "max_context_exchanges": 5
  }
}
