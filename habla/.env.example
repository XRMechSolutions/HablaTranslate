# Habla Translate — Environment Variables
# Copy to .env and fill in required values. .env is never committed to git.

# --- Required ---

# Hugging Face token for Pyannote speaker diarization.
# Get a token at https://huggingface.co/settings/tokens
# Then accept terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# Without this, diarization is disabled (translation still works).
HF_TOKEN=hf_your_token_here

# --- LLM Provider (pick one) ---

# Active provider: ollama | lmstudio | openai | claude
# LLM_PROVIDER=lmstudio

# Ollama (local, free)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# LM Studio (local, free, OpenAI-compatible — Windows only)
# LMSTUDIO_URL=http://localhost:1234
# LMSTUDIO_MODEL=              # auto-detected from /v1/models if blank
# LMSTUDIO_EXECUTABLE=         # path to lms.exe; defaults to PATH lookup
# LMSTUDIO_MODEL_PATHS=        # semicolon-separated full GGUF paths

# OpenAI (cloud, paid — optional, local LLM works without this)
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-5-nano

# Claude / Anthropic (cloud, paid — optional)
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Quick translation model for partials (any provider)
# QUICK_MODEL=
# RATE_LIMIT_INTERVAL=0.5

# --- ASR ---

# WHISPER_MODEL=small           # tiny | base | small | medium | large-v2
# WHISPER_DEVICE=cuda           # cuda | cpu
# ASR_AUTO_LANGUAGE=true        # auto-detect language vs use direction

# --- VAD / Audio Segmentation ---
# Tune these for noisy environments or different speaking styles.
# VAD_SILENCE_MS=600             # ms of silence before finalizing a segment
# MIN_SPEECH_MS=200              # minimum speech length to process (skip coughs)
# MAX_SEGMENT_SECONDS=30.0       # force-split long monologues at this duration
# VAD_THRESHOLD=0.35             # Silero VAD speech probability threshold (lower = more sensitive)
# CALIBRATION_DURATION_MS=2000   # noise floor calibration period on session start

# --- Paths ---

# DB_PATH=data/habla.db
# DATA_DIR=data

# --- HTTPS / Tailscale ---

# Your Tailscale FQDN for HTTPS certificates.
# Run: powershell -Command "(tailscale status --json | ConvertFrom-Json).Self.DNSName.TrimEnd('.')"
# Then: tailscale cert <your-fqdn>
# TAILSCALE_HOST=mylaptop.tail12345.ts.net

# --- Piper TTS ---
# CPU-based text-to-speech. Speaks translated output aloud.
# Requires: pip install piper-tts  +  ONNX voice files in data/tts_models/
# Download voices: https://huggingface.co/rhasspy/piper-voices/tree/main
# TTS_ENABLED=false
# TTS_VOICE_ES=es_ES-carlfm-x_low    # filename without .onnx extension
# TTS_VOICE_EN=en_US-lessac-medium
# TTS_MODELS_DIR=data/tts_models

# --- Recording & WebSocket ---

# RECORDING_ENABLED=false
# WS_PING_INTERVAL=30
# WS_MISSED_PINGS=3
